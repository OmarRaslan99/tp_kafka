{
  "type": "record",
  "name": "LogValue",
  "namespace": "fr.tp_kafka.opr",
  "doc": "Ligne de log serveur web (v3) : ajoute des headers HTTP (record imbrique).",
  "fields": [
    { "name": "ip",       "type": "string", "doc": "Adresse IP du visiteur." },
    { "name": "url",      "type": "string", "doc": "URL visitee." },
    { "name": "datetime", "type": "string", "default": "", "doc": "Horodatage ISO de la requete." },
    { "name": "taille",   "type": "long",   "default": 0,  "doc": "Taille telechargee en octets." },
    {
      "name": "headers",
      "doc": "Quelques headers HTTP d'interet (contenu aleatoire, non exploite).",
      "default": { "referer": "-", "user_agent": "-" },
      "type": {
        "type": "record",
        "name": "HttpHeaders",
        "fields": [
          { "name": "referer",    "type": "string", "default": "-", "doc": "Header Referer." },
          { "name": "user_agent", "type": "string", "default": "-", "doc": "Header User-Agent." }
        ]
      }
    }
  ]
}
